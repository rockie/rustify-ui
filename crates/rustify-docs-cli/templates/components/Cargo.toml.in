[package]
name = "{{package}}"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]
resolver = "2"

[lib]
name = "site_docs"
crate-type = ["rlib", "cdylib"]

[[bin]]
name = "docs-render"
path = "src/bin/docs-render.rs"
required-features = ["ssr"]

[features]
default = []
ssr = ["leptos/ssr", "rustify-docs/site-ssr", "rustify-dom/ssr", "rustify-components/ssr"]
hydrate = ["leptos/hydrate", "rustify-docs/hydrate", "rustify-dom/hydrate", "rustify-components/hydrate"]

[dependencies]
leptos = { version = "=0.8.22", default-features = false }
rustify-docs = { version = "=0.2.1", default-features = false }
rustify-dom = { version = "=0.2.1", default-features = false }
rustify-components = { version = "=0.2.1", default-features = false }

[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = "=0.2.128"

[profile.docs-host]
inherits = "dev"
panic = "unwind"
incremental = true
debug = 0
opt-level = 1
lto = false

[profile.docs-wasm]
inherits = "dev"
panic = "abort"
incremental = true
debug = 0
opt-level = 1
lto = false

[profile.docs-host-release]
inherits = "release"
panic = "unwind"
debug = 0
lto = "thin"

[profile.release]
panic = "abort"
debug = 0
lto = "thin"
codegen-units = 1
