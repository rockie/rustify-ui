      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "SDK legacy default-sized primary variant; CSS variables use light defaults when no scope is present.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Primary action</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;white-space:nowrap;border-radius:var(--radius,6px);font:500 .875rem/1.25rem \"IBM Plex Sans\",sans-serif;height:2.25rem;padding:.5rem 1rem;cursor:pointer;outline:none;transition:all var(--motion-duration,150ms);background:var(--primary,#1570ef);color:var(--primary-foreground,#ffffff);border:0;}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#1570ef) 90%,transparent);}.ds-button-primary:focus-visible{box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#1570ef) 50%,transparent);}.ds-button-primary:disabled,.ds-button-primary[aria-disabled=\"true\"]{opacity:.5;}.ds-button-primary:disabled{pointer-events:none;}.ds-button-primary[aria-disabled=\"true\"]{cursor:not-allowed;}"
    },
