+const DATA_ICON: &str = "data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22/%3E";
+
+fn page_urls(html: &str) -> Vec<(String, bool)> {
+    let dom = dom_query::Document::from(html);
+    let mut urls = Vec::new();
+    for node in dom.select("[href], [src]").nodes() {
+        for attribute in ["href", "src"] {
+            if let Some(value) = node.attr(attribute) {
+                let declared_icon = attribute == "href"
+                    && node.is("head > link[rel=icon]")
+                    && value.as_ref() == DATA_ICON;
+                urls.push((value.to_string(), declared_icon));
+            }
+        }
+    }
+    urls
+}
+
+fn rooted_url(value: &str, declared_icon: bool) -> bool {
+    declared_icon
+        || value.starts_with("/docs/")
+        || value.starts_with('#')
+        || value.starts_with("https://")
+}
+
+fn plain_http_url(value: &str) -> bool {
+    value
+        .trim_ascii()
+        .split_once(':')
+        .is_some_and(|(scheme, _)| scheme.eq_ignore_ascii_case("http"))
+}
+
+#[test]
+fn url_checks_allow_only_the_declared_head_icon_and_reject_http_resources() {
+    let icon = format!("<head><link rel=\"icon\" href=\"{DATA_ICON}\"></head>");
+    let urls = page_urls(&icon);
+    assert_eq!(urls.len(), 1);
+    assert!(rooted_url(&urls[0].0, urls[0].1));
+    assert!(!plain_http_url(&urls[0].0));
+
+    for html in [
+        format!("<body><a href=\"{DATA_ICON}\">Data navigation</a></body>"),
+        format!("<head><link rel=\"stylesheet\" href=\"{DATA_ICON}\"></head>"),
+        "<head><link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg/%3E\"></head>".to_owned(),
+    ] {
+        let urls = page_urls(&html);
+        assert_eq!(urls.len(), 1);
+        assert!(!rooted_url(&urls[0].0, urls[0].1), "{html}");
+    }
+    let urls = page_urls("<img src=\"http://example.test/image.svg\">");
+    assert_eq!(urls.len(), 1);
+    assert!(!rooted_url(&urls[0].0, urls[0].1));
+    assert!(plain_http_url(&urls[0].0));
+}
+
