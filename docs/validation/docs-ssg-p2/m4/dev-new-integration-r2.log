de-group\" data-rd-group=\"install\">\n<div class=\"rd-code-tabs\" hidden><div class=\"rd-code-tablist\" role=\"tablist\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" data-rd-tab=\"0\">Cargo</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-rd-tab=\"1\">Config</button></div></div>\n<figure class=\"rd-code\" data-lang=\"sh\" data-rd-tab-panel=\"0\">\n<figcaption class=\"rd-code-bar\"><span class=\"rd-code-title\">Cargo</span><button type=\"button\" class=\"rd-copy\" data-rd-copy hidden><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg><span class=\"rd-copy-label\">Copy</span></button></figcaption>\n<pre class=\"rd-code-pre\" tabindex=\"0\"><code><span class=\"rd-line\"><span class=\"hl-source hl-shell hl-bash\"><span class=\"hl-meta hl-function-call hl-shell\"><span class=\"hl-variable hl-function hl-shell\">cargo</span></span><span class=\"hl-meta hl-function-call hl-arguments hl-shell\"> install<span class=\"hl-variable hl-parameter hl-option hl-shell\"><span class=\"hl-punctuation hl-definition hl-parameter hl-shell\"> --</span>locked</span> rustify-docs-cli</span></span></span>\n</code></pre>\n<template class=\"rd-code-raw\">cargo install --locked rustify-docs-cli\n</template>\n</figure>\n<figure class=\"rd-code\" data-lang=\"toml\" data-rd-tab-panel=\"1\">\n<figcaption class=\"rd-code-bar\"><span class=\"rd-code-title\">Config</span><button type=\"button\" class=\"rd-copy\" data-rd-copy hidden><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg><span class=\"rd-copy-label\">Copy</span></button></figcaption>\n<pre class=\"rd-code-pre\" tabindex=\"0\"><code><span class=\"rd-line\"><span class=\"hl-source hl-toml\"><span class=\"hl-meta hl-tag hl-key hl-toml\"><span class=\"hl-entity hl-name hl-tag hl-toml\">schema_version</span></span> <span class=\"hl-punctuation hl-definition hl-key-value hl-toml\">=</span> <span class=\"hl-constant hl-numeric hl-integer hl-toml\">1</span></span></span>\n</code></pre>\n<template class=\"rd-code-raw\">schema_version = 1\n</template>\n</figure>\n</div>\n<h3 id=\"check-the-version\">Check the version</h3>\n<p>Run <code>rustify-docs --version</code>; see <a href=\"https://example.com/releases\" rel=\"noopener\">https://example.com/releases</a> for others.</p>\n<div class=\"rd-table\" tabindex=\"0\"><table>\n<thead><tr><th class=\"text-left\">Command</th><th class=\"text-center\">Writes</th><th class=\"text-right\">Network</th></tr></thead>\n<tbody>\n<tr><td class=\"text-left\"><code>check</code></td><td class=\"text-center\">nothing</td><td class=\"text-right\">no</td></tr>\n<tr><td class=\"text-left\"><code>build</code></td><td class=\"text-center\"><code>dist/</code></td><td class=\"text-right\">no</td></tr>\n</tbody></table></div>\n<ul>\n<li><input type=\"checkbox\" disabled checked aria-label=\"Task\"> Install</li>\n<li><input type=\"checkbox\" disabled aria-label=\"Task\"> Write a page<sup class=\"rd-footnote-ref\"><a href=\"#fn-first\" id=\"fnref-first\">1</a></sup></li>\n</ul>\n<p><img src=\"/docs/assets/files/pipeline.9304f52f12.svg\" alt=\"The pipeline\"></p>\n<figure class=\"rd-code\" data-lang=\"rust\">\n<figcaption class=\"rd-code-bar\"><span class=\"rd-code-title\">src/example.rs</span><button type=\"button\" class=\"rd-copy\" data-rd-copy hidden><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg><span class=\"rd-copy-label\">Copy</span></button></figcaption>\n<pre class=\"rd-code-pre\" tabindex=\"0\"><code><span class=\"rd-line\"><span class=\"hl-source hl-rust\"><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-storage hl-type hl-function hl-rust\">fn</span> </span><span class=\"hl-entity hl-name hl-function hl-rust\">main</span></span><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-function hl-parameters hl-rust\"><span class=\"hl-punctuation hl-section hl-parameters hl-begin hl-rust\">(</span></span><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-function hl-parameters hl-rust\"><span class=\"hl-punctuation hl-section hl-parameters hl-end hl-rust\">)</span></span></span></span><span class=\"hl-meta hl-function hl-rust\"> </span><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-block hl-rust\"><span class=\"hl-punctuation hl-section hl-block hl-begin hl-rust\">{</span></span></span></span></span>\n<span class=\"rd-line\"><span class=\"hl-source hl-rust\"><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-block hl-rust\">    <span class=\"hl-support hl-macro hl-rust\">println!</span><span class=\"hl-meta hl-group hl-rust\"><span class=\"hl-punctuation hl-section hl-group hl-begin hl-rust\">(</span></span><span class=\"hl-meta hl-group hl-rust\"><span class=\"hl-string hl-quoted hl-double hl-rust\"><span class=\"hl-punctuation hl-definition hl-string hl-begin hl-rust\">&quot;</span>hello again<span class=\"hl-punctuation hl-definition hl-string hl-end hl-rust\">&quot;</span></span></span><span class=\"hl-meta hl-group hl-rust\"><span class=\"hl-punctuation hl-section hl-group hl-end hl-rust\">)</span></span><span class=\"hl-punctuation hl-terminator hl-rust\">;</span></span></span></span></span>\n<span class=\"rd-line\"><span class=\"hl-source hl-rust\"><span class=\"hl-meta hl-function hl-rust\"><span class=\"hl-meta hl-block hl-rust\"><span class=\"hl-punctuation hl-section hl-block hl-end hl-rust\">}</span></span></span></span></span>\n</code></pre>\n<template class=\"rd-code-raw\">fn main() {\n    println!(&quot;hello again&quot;);\n}\n</template>\n</figure>\n<p>The source is <a href=\"https://github.com/example/fixture/blob/main/src/example.rs\" rel=\"noopener\">on GitHub</a>.</p>\n<div class=\"markdown-alert markdown-alert-warning\" role=\"note\">\n<p class=\"markdown-alert-title\"><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3 2 20h20z\"/><path d=\"M12 9v5M12 17h.01\"/></svg>Warning</p>\n<p>Drafts are left out of a production build.</p>\n</div>\n<p>Once installed, the same choice applies here:</p>\n<div class=\"rd-code-group\" data-rd-group=\"install\">\n<div class=\"rd-code-tabs\" hidden><div class=\"rd-code-tablist\" role=\"tablist\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" data-rd-tab=\"0\">Cargo</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-rd-tab=\"1\">Config</button></div></div>\n<figure class=\"rd-code\" data-lang=\"sh\" data-rd-tab-panel=\"0\">\n<figcaption class=\"rd-code-bar\"><span class=\"rd-code-title\">Cargo</span><button type=\"button\" class=\"rd-copy\" data-rd-copy hidden><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg><span class=\"rd-copy-label\">Copy</span></button></figcaption>\n<pre class=\"rd-code-pre\" tabindex=\"0\"><code><span class=\"rd-line\"><span class=\"hl-source hl-shell hl-bash\"><span class=\"hl-meta hl-function-call hl-shell\"><span class=\"hl-variable hl-function hl-shell\">cargo</span></span><span class=\"hl-meta hl-function-call hl-arguments hl-shell\"> install<span class=\"hl-variable hl-parameter hl-option hl-shell\"><span class=\"hl-punctuation hl-definition hl-parameter hl-shell\"> --</span>list</span></span></span></span>\n</code></pre>\n<template class=\"rd-code-raw\">cargo install --list\n</template>\n</figure>\n<figure class=\"rd-code\" data-lang=\"toml\" data-rd-tab-panel=\"1\">\n<figcaption class=\"rd-code-bar\"><span class=\"rd-code-title\">Config</span><button type=\"button\" class=\"rd-copy\" data-rd-copy hidden><svg class=\"rd-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/></svg><span class=\"rd-copy-label\">Copy</span></button></figcaption>\n<pre class=\"rd-code-pre\" tabindex=\"0\"><code><span class=\"rd-line\"><span class=\"hl-source hl-toml\"><span class=\"hl-punctuation hl-definition hl-table hl-begin hl-toml\">[</span><span class=\"hl-meta hl-tag hl-table hl-toml\"><span class=\"hl-entity hl-name hl-table hl-toml\">site</span></span><span class=\"hl-punctuation hl-definition hl-table hl-end hl-toml\">]</span></span></span>\n<span class=\"rd-line\"><span class=\"hl-source hl-toml\"><span class=\"hl-meta hl-tag hl-key hl-toml\"><span class=\"hl-entity hl-name hl-tag hl-toml\">name</span></span> <span class=\"hl-punctuation hl-definition hl-key-value hl-toml\">=</span> <span class=\"hl-string hl-quoted hl-double hl-basic hl-toml\"><span class=\"hl-punctuation hl-definition hl-string hl-begin hl-toml\">&quot;</span>Docs<span class=\"hl-punctuation hl-definition hl-string hl-end hl-to