            "cyan",
            "teal",
            "jade",
            "green",
            "grass",
            "lime",
            "mint",
            "sky"
          ]
        },
        "gray_color": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "auto",
            "gray",
            "mauve",
            "slate",
            "sage",
            "olive",
            "sand"
          ]
        },
        "panel_background": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "solid",
            "translucent"
          ]
        },
        "radius": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "none",
            "small",
            "medium",
            "large",
            "full"
          ]
        },
        "scaling": {
          "type": "integer",
          "enum": [
            90,
            95,
            100,
            105,
            110
          ]
        }
      }
    },
