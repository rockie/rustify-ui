      "additionalProperties": {
        "type": "string"
      },
      "description": "Author strings. resolve validates color grammar, fonts and numeric limits with the supplied rem/font context; unknown string tokens are preserved with diagnostics."
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance",
        "accent_color",
        "gray_color",
        "panel_background",
        "radius",
        "scaling"
      ],
      "properties": {
        "appearance": {
          "type": "string",
          "enum": [
            "inherit",
            "light",
            "dark"
          ]
        },
        "accent_color": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "gray",
            "gold",
            "bronze",
            "brown",
            "yellow",
            "amber",
            "orange",
            "tomato",
